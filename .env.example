# fomoapi.io — unofficial fomo data provider. Never commit a real key.
FOMO_API_BASE_URL=https://api.fomoapi.io
FOMO_API_KEY=

# Leave empty. Wallet → handle is not a confirmed fomoapi route.
# Do not put a guessed path here. The adapter ignores this until a path and
# response schema are confirmed in code.
FOMO_WALLET_LOOKUP_PATH=

# $DRAW mint address. Required by the identity adapter when a thesis lookup runs.
DRAW_MINT=

# Supabase Postgres connection string. close-window does not publish rows until this is set.
DATABASE_URL=

# Helius. HELIUS_API_KEY reads enhanced swap history for bonus entries.
# HELIUS_RPC_URL confirms token balances at the snapshot.
# close-window does not publish entries until balances are confirmed.
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WEBHOOK_SECRET=

# Draw window length in whole hours. Scheduler stub only.
DRAW_WINDOW_HOURS=1

# Base entry: hold at least this many integer US cents at the snapshot. 500 = $5.00.
MIN_HOLD_USD_CENTS=500
# Bonus entries: in-window buys of at least this many cents. 500 = $5.00.
MIN_WINDOW_BUY_USD_CENTS=500
# Extra entries added on top of the base entry when the window buy qualifies.
BONUS_ENTRIES=2

# Worker stays idle unless this is the string true.
DRAW_SCHEDULER_ENABLED=false
